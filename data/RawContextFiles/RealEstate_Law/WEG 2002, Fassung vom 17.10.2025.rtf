\par }\pard\plain \ltrpar\s38\qj \fi397\li0\ri0\sb80\sl-220\slmult0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid1059059 \rtlch\fcs1 \af0\afs20\alang1025 \ltrch\fcs0 \fs20\cf1\lang3079\langfe3079\langnp3079\langfenp3079 {

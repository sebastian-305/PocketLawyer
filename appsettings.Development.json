{
    "Logging": {
        "File": {
            "Enabled": true,
            "MinimumLevel": "Information",
            "Path": "logs"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.StaticFiles": "Warning",
                "Microsoft.Extensions.Http": "Warning",
                "System.Net.Http.HttpClient": "Warning",
                "PocketLawyer": "Verbose",
                "PocketLawyer.Infrastructure.Logging": "Verbose"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            }
        ]
    },
    "Nebius": {

    },
    "Paths": {
        "ResponsesPath": "data/Responses",
        "TesseractDataPath": "data/tessdata",
        "KVSPath": "data/KVS/Employment"
    },
    "Upload": {
        "MaxUploadSizeMB": 20
    },
    "Context": {
        "BasePath": "data/Context",
        "CreateReadmeFiles": true,
        "MaxContextSizeBytes": 10485760
    }
}

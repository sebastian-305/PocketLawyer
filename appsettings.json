{
    "Logging": {
        "File": {
            "Enabled": true,
            "MinimumLevel": "Information",
            "Path": "logs"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.StaticFiles": "Warning",
                "Microsoft.Extensions.Http": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            }
        ]
    },
  "AllowedHosts": "*",
    "Gemini": {
        //"ModelId": "gemini-1.5-flash-002",
        "ModelId": "gemini-2.0-flash-001",
        "WriteGeminiResponseInFile": false
    },
    "Nebius": {
        //"ModelId": "Qwen/Qwen3-30B-A3B",
        //"ModelId": "Qwen/Qwen3-30B-A3B-Instruct-2507"
        "ModelId": "meta-llama/Llama-3.3-70B-Instruct"


        //"ModelId": "meta-llama/Llama-3.3-70B-Instruct-fast"

        //"ModelId": "meta-llama/Meta-Llama-3.1-8B-Instruct-fast"
    },
  "Paths": {
    "ResponsesPath": "data/Responses",
    "TesseractDataPath": "data/tessdata",
    "KVSPath": "data/KVS"
  },
  "Upload": {
    "MaxUploadSizeMB": 20
  },
  "Context": {
    "BasePath": "data/Context",
    "CreateReadmeFiles": true,
    "MaxContextSizeBytes": 5242880
  }
}

using FsCheck;
using FsCheck.Xunit;
using System.Diagnostics;
using System.Reflection;
using System.Text.RegularExpressions;

namespace PocketLawyer.Tests.Infrastructure;

/// <summary>
/// Property-based tests for build error reporting.
/// **Feature: repository-production-readiness**
/// 
/// DEAKTIVIERT: Diese Tests führen dotnet build aus und können hängen bleiben.
/// </summary>
[Trait("Category", "Disabled")]
public class BuildErrorReportingPropertyTests
{
    #region Test Data and Generators

    /// <summary>
    /// Represents a build or test failure with detailed information.
    /// </summary>
    private record BuildFailureInfo(
        string ErrorType,
        string? FilePath,
        int? LineNumber,
        string ErrorMessage,
        string? StackTrace);

    /// <summary>
    /// Gets the project root directory by walking up from the test assembly location.
    /// </summary>
    private static string GetProjectRootDirectory()
    {
        var assemblyLocation = Assembly.GetExecutingAssembly().Location;
        var directory = Path.GetDirectoryName(assemblyLocation);

        // Walk up until we find the solution file or reach a reasonable limit
        while (directory != null && !File.Exists(Path.Combine(directory, "PocketLawyer.sln")))
        {
            directory = Directory.GetParent(directory)?.FullName;
        }

        if (directory == null)
        {
            throw new InvalidOperationException("Could not find project root directory");
        }

        return directory;
    }

    /// <summary>
    /// Executes a dotnet build command and captures the output.
    /// </summary>
    private static (int exitCode, string output, string error) ExecuteBuild(string configuration = "Release")
    {
        var projectRoot = GetProjectRootDirectory();
        
        var processStartInfo = new ProcessStartInfo
        {
            FileName = "dotnet",
            Arguments = $"build --configuration {configuration} --no-restore",
            WorkingDirectory = projectRoot,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };

        using var process = Process.Start(processStartInfo);
        if (process == null)
        {
            throw new InvalidOperationException("Failed to start build process");
        }

        var output = process.StandardOutput.ReadToEnd();
        var error = process.StandardError.ReadToEnd();
        process.WaitForExit();

        return (process.ExitCode, output, error);
    }

    /// <summary>
    /// Executes a dotnet test command and captures the output.
    /// </summary>
    private static (int exitCode, string output, string error) ExecuteTests(string configuration = "Release")
    {
        var projectRoot = GetProjectRootDirectory();
        
        var processStartInfo = new ProcessStartInfo
        {
            FileName = "dotnet",
            Arguments = $"test --configuration {configuration} --no-build --verbosity minimal",
            WorkingDirectory = projectRoot,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };

        using var process = Process.Start(processStartInfo);
        if (process == null)
        {
            throw new InvalidOperationException("Failed to start test process");
        }

        var output = process.StandardOutput.ReadToEnd();
        var error = process.StandardError.ReadToEnd();
        process.WaitForExit();

        return (process.ExitCode, output, error);
    }

    /// <summary>
    /// Parses build/test output to extract failure information.
    /// </summary>
    private static List<BuildFailureInfo> ParseFailures(string output)
    {
        var failures = new List<BuildFailureInfo>();

        // Pattern for compilation errors: path(line,col): error CODE: message
        var compilationErrorPattern = new Regex(
            @"(?<path>[^(]+)\((?<line>\d+),\d+\):\s*error\s+(?<code>\w+):\s*(?<message>.+)",
            RegexOptions.Multiline);

        // Pattern for test errors: path(line): error TESTERROR: TestName (duration): message
        var testErrorPattern = new Regex(
            @"(?<path>[^(]+)\((?<line>\d+)\):\s*error\s+TESTERROR:\s*(?<test>[^\(]+)\s*\([^)]+\):\s*(?<message>.+?)(?=\n\s*Stapelverfolgung:|$)",
            RegexOptions.Multiline | RegexOptions.Singleline);

        // Parse compilation errors
        foreach (Match match in compilationErrorPattern.Matches(output))
        {
            failures.Add(new BuildFailureInfo(
                ErrorType: "CompilationError",
                FilePath: match.Groups["path"].Value.Trim(),
                LineNumber: int.Parse(match.Groups["line"].Value),
                ErrorMessage: match.Groups["message"].Value.Trim(),
                StackTrace: null));
        }

        // Parse test errors
        foreach (Match match in testErrorPattern.Matches(output))
        {
            var stackTraceMatch = Regex.Match(
                output.Substring(match.Index),
                @"Stapelverfolgung:\s*(.+?)(?=\n\s*(?:D:\\|C:\\|$))",
                RegexOptions.Singleline);

            failures.Add(new BuildFailureInfo(
                ErrorType: "TestFailure",
                FilePath: match.Groups["path"].Value.Trim(),
                LineNumber: int.TryParse(match.Groups["line"].Value, out var line) ? line : null,
                ErrorMessage: match.Groups["message"].Value.Trim(),
                StackTrace: stackTraceMatch.Success ? stackTraceMatch.Groups[1].Value.Trim() : null));
        }

        return failures;
    }

    /// <summary>
    /// Generator for build failure information from actual build/test output.
    /// </summary>
    private static Gen<BuildFailureInfo> GenBuildFailure()
    {
        // Execute tests to get actual failures
        var (exitCode, output, error) = ExecuteTests();
        var failures = ParseFailures(output + error);

        if (failures.Count == 0)
        {
            // If no failures, create synthetic test data
            return Gen.Elements(
                new BuildFailureInfo(
                    ErrorType: "CompilationError",
                    FilePath: "Domain/TestFile.cs",
                    LineNumber: 42,
                    ErrorMessage: "CS0246: The type or namespace name 'TestType' could not be found",
                    StackTrace: null),
                new BuildFailureInfo(
                    ErrorType: "TestFailure",
                    FilePath: "PocketLawyer.Tests/TestClass.cs",
                    LineNumber: 100,
                    ErrorMessage: "Assert.Equal() Failure",
                    StackTrace: "at TestClass.TestMethod() in TestClass.cs:line 100"));
        }

        return Gen.Elements(failures.ToArray());
    }

    #endregion

    #region Property 19: Build Error Reporting

    /// <summary>
    /// **Feature: repository-production-readiness, Property 19: Build Error Reporting**
    /// **Validates: Requirements 9.3, 9.5**
    /// 
    /// For any build or test failure, the system should report the failure with detailed information.
    /// This includes file location, error message, and stack trace where applicable.
    /// </summary>
    [Property(MaxTest = 10)]
    public Property BuildFailures_ShouldContainDetailedInformation()
    {
        // Use a static list of failures to avoid running builds repeatedly
        var (exitCode, output, error) = ExecuteTests();
        var failures = ParseFailures(output + error);

        if (failures.Count == 0)
        {
            // If no failures, create synthetic test data
            failures = new List<BuildFailureInfo>
            {
                new BuildFailureInfo(
                    ErrorType: "CompilationError",
                    FilePath: "Domain/TestFile.cs",
                    LineNumber: 42,
                    ErrorMessage: "CS0246: The type or namespace name 'TestType' could not be found",
                    StackTrace: null),
                new BuildFailureInfo(
                    ErrorType: "TestFailure",
                    FilePath: "PocketLawyer.Tests/TestClass.cs",
                    LineNumber: 100,
                    ErrorMessage: "Assert.Equal() Failure",
                    StackTrace: "at TestClass.TestMethod() in TestClass.cs:line 100")
            };
        }

        return Prop.ForAll(
            Gen.Elements(failures.ToArray()).ToArbitrary(),
            failure =>
            {
                // Every failure should have an error type
                Assert.NotNull(failure.ErrorType);
                Assert.NotEmpty(failure.ErrorType);

                // Every failure should have an error message
                Assert.NotNull(failure.ErrorMessage);
                Assert.NotEmpty(failure.ErrorMessage);

                // Compilation errors should have file path and line number
                if (failure.ErrorType == "CompilationError")
                {
                    Assert.NotNull(failure.FilePath);
                    Assert.NotEmpty(failure.FilePath);
                    Assert.NotNull(failure.LineNumber);
                    Assert.True(failure.LineNumber > 0, 
                        "Compilation error should have a valid line number");
                }

                // Test failures should have file path
                if (failure.ErrorType == "TestFailure")
                {
                    Assert.NotNull(failure.FilePath);
                    Assert.NotEmpty(failure.FilePath);
                }

                return true;
            }
        );
    }

    #endregion

    #region Unit Tests for Build Error Reporting

    /// <summary>
    /// Unit test: Verify build command executes successfully.
    /// </summary>
    [Fact]
    public void BuildCommand_ShouldExecute()
    {
        // Act
        var (exitCode, output, error) = ExecuteBuild();

        // Assert
        Assert.NotNull(output);
        // Note: exitCode may be 0 (success) or non-zero (failure with errors)
        // We're just verifying the command executes
    }

    /// <summary>
    /// Unit test: Verify test command executes successfully.
    /// </summary>
    [Fact]
    public void TestCommand_ShouldExecute()
    {
        // Act
        var (exitCode, output, error) = ExecuteTests();

        // Assert
        Assert.NotNull(output);
        // Note: exitCode may be 0 (success) or non-zero (failure with errors)
        // We're just verifying the command executes
    }


    /// <summary>
    /// Unit test: Verify actual build output contains detailed error information when failures occur.
    /// </summary>
    [Fact]
    public void ActualBuildOutput_WhenFailuresExist_ShouldContainDetailedInformation()
    {
        // Act
        var (exitCode, output, error) = ExecuteTests();
        var fullOutput = output + error;
        var failures = ParseFailures(fullOutput);

        // Assert
        if (failures.Count > 0)
        {
            // If there are failures, verify they contain detailed information
            foreach (var failure in failures)
            {
                Assert.NotNull(failure.ErrorType);
                Assert.NotEmpty(failure.ErrorType);
                Assert.NotNull(failure.ErrorMessage);
                Assert.NotEmpty(failure.ErrorMessage);

                if (failure.ErrorType == "CompilationError")
                {
                    Assert.NotNull(failure.FilePath);
                    Assert.NotNull(failure.LineNumber);
                }
            }
        }
        // If no failures, test passes (build is successful)
    }


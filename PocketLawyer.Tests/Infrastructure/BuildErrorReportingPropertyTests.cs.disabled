    [Fact]
    public void ParsedFailures_ShouldHaveRequiredFields()
    {
        // Act
        var (exitCode, output, error) = ExecuteTests();
        var failures = ParseFailures(output + error);

        // Assert
        foreach (var failure in failures)
        {
            Assert.NotNull(failure.ErrorType);
            Assert.NotEmpty(failure.ErrorType);
            Assert.NotNull(failure.ErrorMessage);
            Assert.NotEmpty(failure.ErrorMessage);
        }
    }

    /// <summary>
    /// Unit test: Verify compilation errors have file location.
    /// </summary>
    [Fact]
    public void CompilationErrors_ShouldHaveFileLocation()
    {
        // Act
        var (exitCode, output, errorOutput) = ExecuteTests();
        var failures = ParseFailures(output + errorOutput);
        var compilationErrors = failures.Where(f => f.ErrorType == "CompilationError").ToList();

        // Assert
        foreach (var compError in compilationErrors)
        {
            Assert.NotNull(compError.FilePath);
            Assert.NotEmpty(compError.FilePath);
            Assert.NotNull(compError.LineNumber);
            Assert.True(compError.LineNumber > 0);
        }
    }

    /// <summary>
    /// Unit test: Verify test failures have file location.
    /// </summary>
    [Fact]
    public void TestFailures_ShouldHaveFileLocation()
    {
        // Act
        var (exitCode, output, error) = ExecuteTests();
        var failures = ParseFailures(output + error);
        var testFailures = failures.Where(f => f.ErrorType == "TestFailure").ToList();

        // Assert
        foreach (var failure in testFailures)
        {
            Assert.NotNull(failure.FilePath);
            Assert.NotEmpty(failure.FilePath);
        }
    }


    /// <summary>
    /// Unit test: Verify build output contains build status.
    /// </summary>
    [Fact]
    public void BuildOutput_ShouldContainBuildStatus()
    {
        // Act
        var (exitCode, output, error) = ExecuteBuild();
        var fullOutput = output + error;

        // Assert
        Assert.True(
            fullOutput.Contains("Erfolgreich", StringComparison.OrdinalIgnoreCase) ||
            fullOutput.Contains("fehlerhaft", StringComparison.OrdinalIgnoreCase) ||
            fullOutput.Contains("Success", StringComparison.OrdinalIgnoreCase) ||
            fullOutput.Contains("Failed", StringComparison.OrdinalIgnoreCase),
            "Build output should contain build status");
    }

    /// <summary>
    /// Unit test: Verify test output contains test summary.
    /// </summary>
    [Fact]
    public void TestOutput_ShouldContainTestSummary()
    {
        // Act
        var (exitCode, output, error) = ExecuteTests();
        var fullOutput = output + error;

        // Assert
        Assert.True(
            fullOutput.Contains("insgesamt", StringComparison.OrdinalIgnoreCase) ||
            fullOutput.Contains("Total", StringComparison.OrdinalIgnoreCase) ||
            fullOutput.Contains("tests", StringComparison.OrdinalIgnoreCase),
            "Test output should contain test summary");
    }

    /// <summary>
    /// Unit test: Verify failure parser can extract compilation errors.
    /// </summary>
    [Fact]
    public void FailureParser_ShouldExtractCompilationErrors()
    {
        // Arrange
        var sampleOutput = @"
Domain/TestFile.cs(42,10): error CS0246: The type or namespace name 'TestType' could not be found
Infrastructure/Service.cs(100,5): error CS0103: The name 'variable' does not exist
";

        // Act
        var failures = ParseFailures(sampleOutput);

        // Assert
        Assert.NotEmpty(failures);
        var compilationErrors = failures.Where(f => f.ErrorType == "CompilationError").ToList();
        Assert.NotEmpty(compilationErrors);
        
        var firstError = compilationErrors.First();
        Assert.NotNull(firstError.FilePath);
        Assert.NotNull(firstError.LineNumber);
        Assert.NotNull(firstError.ErrorMessage);
    }

    /// <summary>
    /// Unit test: Verify failure parser can extract test failures.
    /// </summary>
    [Fact]
    public void FailureParser_ShouldExtractTestFailures()
    {
        // Arrange
        var sampleOutput = @"
PocketLawyer.Tests/TestClass.cs(100): error TESTERROR:
      TestMethod (50ms): Fehlermeldung: Assert.Equal() Failure
      Expected: 5
      Actual: 10
      Stapelverfolgung:
         at TestClass.TestMethod() in TestClass.cs:line 100
";

        // Act
        var failures = ParseFailures(sampleOutput);

        // Assert
        Assert.NotEmpty(failures);
        var testFailures = failures.Where(f => f.ErrorType == "TestFailure").ToList();
        Assert.NotEmpty(testFailures);
        
        var firstFailure = testFailures.First();
        Assert.NotNull(firstFailure.FilePath);
        Assert.NotNull(firstFailure.ErrorMessage);
    }

